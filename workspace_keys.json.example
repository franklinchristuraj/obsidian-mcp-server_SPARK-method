{
  "keys": {
    "sk_admin_REPLACE_ME": {
      "name": "Admin / Interactive",
      "scopes": ["personal", "passion", "work", "parallax"],
      "write_scopes": ["personal", "passion", "work", "parallax"],
      "role": "admin"
    },
    "sk_parallax_agent_REPLACE_ME": {
      "name": "Parallax agent",
      "scopes": ["personal", "passion", "work", "parallax"],
      "write_scopes": ["parallax"],
      "role": "agent"
    },
    "sk_personal_REPLACE_ME": {
      "name": "Personal Claude",
      "scopes": ["personal", "passion"],
      "role": "user"
    },
    "sk_work_REPLACE_ME": {
      "name": "Work Claude",
      "scopes": ["work"],
      "role": "user"
    },
    "sk_passion_agent_REPLACE_ME": {
      "name": "Passion agent (no parallax)",
      "scopes": ["passion"],
      "role": "agent"
    }
  },
  "oauth_clients": {
    "paste-oauth-client-id-here": {
      "name": "Claude web client",
      "scopes": ["personal", "passion", "work", "parallax"],
      "write_scopes": ["personal", "passion", "work", "parallax"],
      "role": "user"
    }
  }
}
